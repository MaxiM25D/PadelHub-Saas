{
  "name": "padelhub-saas",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": { "node": ">=20.9.0" },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml,css}\"",
    "db:generate": "pnpm --filter @padelhub/database db:generate",
    "db:migrate": "pnpm --filter @padelhub/database db:migrate",
    "db:studio": "pnpm --filter @padelhub/database db:studio",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.10.10",
    "typescript": "^5.9.3"
  }
}
